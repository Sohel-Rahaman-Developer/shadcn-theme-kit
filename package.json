{
  "name": "shadcn-theme-kit",
  "version": "1.2.1",
  "description": "Easy theme configuration for React + shadcn with light/dark mode, preset themes, and CSS variables",
  "author": "Sohel Rahaman",
  "license": "MIT",
  "keywords": [
    "shadcn",
    "theme",
    "react",
    "tailwind",
    "dark-mode",
    "light-mode",
    "css-variables",
    "theming",
    "color-scheme",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sohel-Rahaman-Developer/shadcn-theme-kit.git"
  },
  "homepage": "https://github.com/Sohel-Rahaman-Developer/shadcn-theme-kit#readme",
  "bugs": {
    "url": "https://github.com/Sohel-Rahaman-Developer/shadcn-theme-kit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.mjs",
      "require": "./dist/presets/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./ThemeScript": {
      "types": "./dist/ThemeScript.d.ts",
      "import": "./dist/ThemeScript.mjs",
      "require": "./dist/ThemeScript.js"
    },
    "./cookies": {
      "types": "./dist/utils/cookies.d.ts",
      "import": "./dist/utils/cookies.mjs",
      "require": "./dist/utils/cookies.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run type-check && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
